# Dependencies (reinstalled inside Docker)
node_modules
apps/*/node_modules
packages/*/node_modules

# Build outputs (rebuilt inside Docker)
.next
apps/*/.next
packages/*/dist

# Python backend (not needed for frontend)
.venv
venv
__pycache__
*.pyc
*.egg-info
*.db
*.sqlite3

# Git
.git
.gitignore

# IDE
.vscode
.idea

# OS
.DS_Store
Thumbs.db

# Environment files (secrets — never bake into images)
.env
.env.local
.env.production
apps/web/.env.local

# Docker files
Dockerfile*
docker-compose*.yml

# Turbo cache
.turbo
apps/*/.turbo
packages/*/.turbo

# Misc
uploads
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
*.log
walkthrough.md
